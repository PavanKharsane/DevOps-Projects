pipeline {
    agent any

    tools {
        jdk 'jdk8'
        maven 'maven-3.9'
    }

    environment {
        APP_NAME = 'sample-app'
        IMAGE = "sample-app:${env.GIT_COMMIT ?: env.BUILD_NUMBER}"
        SONAR_PROJECT_KEY = 'devops-project-06'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (!env.BRANCH_NAME) {
                        error 'This Jenkinsfile must run from a Multibranch Pipeline.'
                    }
                }
            }
        }

        stage('Validate') {
            steps {
                bat 'git diff --check'
                bat 'if not exist pom.xml exit /b 1'
                bat 'if not exist Dockerfile exit /b 1'
            }
        }

        stage('Build and Test') {
            steps {
                bat 'mvn -B clean verify'
            }
            post {
                always {
                    junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: false
                    archiveArtifacts artifacts: 'target/*.jar,target/site/jacoco/**', allowEmptyArchive: false
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                anyOf {
                    branch 'main'
                    changeRequest()
                }
            }
            steps {
                withSonarQubeEnv('local-sonarqube') {
                    bat 'mvn -B sonar:sonar -Dsonar.projectKey=%SONAR_PROJECT_KEY%'
                }
            }
        }

        stage('SonarQube Quality Gate') {
            when {
                anyOf {
                    branch 'main'
                    changeRequest()
                }
            }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Dependency Scan') {
            steps {
                bat 'mvn -B org.owasp:dependency-check-maven:check -DfailBuildOnCVSS=7'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'target/dependency-check-report.*', allowEmptyArchive: true
                }
            }
        }

        stage('Secret Scan') {
            steps {
                bat 'trivy fs --scanners secret --severity HIGH,CRITICAL --exit-code 1 .'
            }
        }

        stage('Docker Build') {
            when {
                anyOf {
                    branch 'main'
                    changeRequest()
                }
            }
            steps {
                bat 'docker build --tag %IMAGE% .'
            }
        }

        stage('Container Scan') {
            when {
                anyOf {
                    branch 'main'
                    changeRequest()
                }
            }
            steps {
                bat 'trivy image --severity HIGH,CRITICAL --exit-code 1 %IMAGE%'
            }
        }

        stage('Deploy to Local Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([
                    string(credentialsId: 'app-consumer-key', variable: 'CONSUMER_KEY'),
                    string(credentialsId: 'app-consumer-secret', variable: 'CONSUMER_SECRET'),
                    string(credentialsId: 'app-access-token', variable: 'ACCESS_TOKEN'),
                    string(credentialsId: 'app-access-token-secret', variable: 'ACCESS_TOKEN_SECRET')
                ]) {
                    bat 'kubectl apply -f namespace.yaml'
                    bat 'kubectl create secret generic app-runtime --namespace sample-app --from-literal=consumer-key=%CONSUMER_KEY% --from-literal=consumer-secret=%CONSUMER_SECRET% --from-literal=access-token=%ACCESS_TOKEN% --from-literal=access-token-secret=%ACCESS_TOKEN_SECRET% --dry-run=client -o yaml | kubectl apply -f -'
                    bat 'kubectl apply -f deployment.yaml'
                    bat 'kubectl apply -f service.yaml'
                    bat 'kubectl rollout status deployment/sample-app-dep --namespace sample-app --timeout=5m'
                }
            }
        }

        stage('Smoke Test') {
            when {
                branch 'main'
            }
            steps {
                bat 'kubectl get service sample-app-service --namespace sample-app'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-*.json', allowEmptyArchive: true
        }
    }
}
